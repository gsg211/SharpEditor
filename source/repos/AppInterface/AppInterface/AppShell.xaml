<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppInterface.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:AppInterface.UI"
    Title="AppInterface">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate ui:LoginPage}"
        Route="LoginPage" />
    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate ui:RegisterPage}"
        Route="RegisterPage" />

</Shell>