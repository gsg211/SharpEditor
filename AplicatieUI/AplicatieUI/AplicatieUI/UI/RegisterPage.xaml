<?xml version="1.0" encoding="utf-8" ?>

<!-- Author: Miron Victor -->
<!-- 
    Sign-up page with a registration form. 
    Contains input fields for username, email, password, and password confirmation. 
    Includes a "Create Account" button and a link to navigate back to the login screen.
-->



<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AplicatieUI.UI.RegisterPage"
             Title=""
             BackgroundColor="#0F1117">

    <ScrollView>
        <VerticalStackLayout
            Padding="32,60,32,32"
            Spacing="0"
            VerticalOptions="Center">

            <Label
                Text="SharpEditor"
                FontSize="36"
                FontAttributes="Bold"
                TextColor="#E8E8F0"
                HorizontalOptions="Center"
                Margin="0,0,0,6"/>

            <Label
                Text="Document collaboration platform"
                FontSize="13"
                TextColor="#6B6B80"
                HorizontalOptions="Center"
                Margin="0,0,0,48"/>

            <Border
                BackgroundColor="#1A1D27"
                StrokeShape="RoundRectangle 16"
                Stroke="#2A2D3E"
                StrokeThickness="1"
                Padding="28,32">

                <VerticalStackLayout Spacing="20">

                    <Label
                        Text="Create Account"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#E8E8F0"
                        Margin="0,0,0,4"/>

                    <!-- Username -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Username"
                            FontSize="13"
                            TextColor="#9090A8"
                            FontAttributes="Bold"/>
                        <Entry
                            x:Name="UsernameEntry"
                            Placeholder="Choose a username"
                            PlaceholderColor="#4A4A60"
                            TextColor="#E8E8F0"
                            BackgroundColor="#252836"
                            FontSize="15"
                            HeightRequest="48"
                            ReturnType="Next"/>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Email"
                            FontSize="13"
                            TextColor="#9090A8"
                            FontAttributes="Bold"/>
                        <Entry
                            x:Name="EmailEntry"
                            Placeholder="Enter your email"
                            PlaceholderColor="#4A4A60"
                            TextColor="#E8E8F0"
                            BackgroundColor="#252836"
                            FontSize="15"
                            HeightRequest="48"
                            Keyboard="Email"
                            ReturnType="Next"/>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Password"
                            FontSize="13"
                            TextColor="#9090A8"
                            FontAttributes="Bold"/>
                        <Entry
                            x:Name="PasswordEntry"
                            Placeholder="Enter your password"
                            PlaceholderColor="#4A4A60"
                            TextColor="#E8E8F0"
                            BackgroundColor="#252836"
                            FontSize="15"
                            HeightRequest="48"
                            IsPassword="True"
                            ReturnType="Next"/>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Confirm Password"
                            FontSize="13"
                            TextColor="#9090A8"
                            FontAttributes="Bold"/>
                        <Entry
                            x:Name="ConfirmPasswordEntry"
                            Placeholder="Repeat your password"
                            PlaceholderColor="#4A4A60"
                            TextColor="#E8E8F0"
                            BackgroundColor="#252836"
                            FontSize="15"
                            HeightRequest="48"
                            IsPassword="True"
                            ReturnType="Done"/>
                    </VerticalStackLayout>

                    <!-- Mesaj eroare / succes -->
                    <Label
                        x:Name="ErrorLabel"
                        Text=""
                        FontSize="13"
                        TextColor="#FF6B6B"
                        IsVisible="False"
                        HorizontalOptions="Center"/>

                    <!-- Buton Register -->
                    <Button
                        x:Name="RegisterButton"
                        Text="Create Account"
                        BackgroundColor="#4F6EF7"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnRegisterClicked"
                        Margin="0,4,0,0"/>

                    <ActivityIndicator
                        x:Name="LoadingIndicator"
                        IsRunning="False"
                        IsVisible="False"
                        Color="#4F6EF7"
                        HorizontalOptions="Center"/>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#2A2D3E"
                        Margin="0,4"/>

                    <!-- Link spre Login -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4">
                        <Label
                            Text="Already have an account?"
                            FontSize="13"
                            TextColor="#6B6B80"
                            VerticalOptions="Center"/>
                        <Label
                            Text="Sign In"
                            FontSize="13"
                            TextColor="#4F6EF7"
                            FontAttributes="Bold"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignInTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>