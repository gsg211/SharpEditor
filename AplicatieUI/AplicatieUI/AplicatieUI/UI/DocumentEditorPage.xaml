<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AplicatieUI.UI.DocumentEditorPage"
             Title=""
             BackgroundColor="#0F1117">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24,48,24,24">

        <!-- Header - titlu document -->
        <VerticalStackLayout Grid.Row="0" Margin="0,0,0,16">
            <Label
                x:Name="DocumentTitleLabel"
                Text="Document"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#E8E8F0"/>
            <Label
                x:Name="PermissionLabel"
                Text="Owner"
                FontSize="12"
                TextColor="#4F6EF7"
                Margin="0,4,0,0"/>
        </VerticalStackLayout>

        <!-- Butoane Save, Undo, Redo, Close -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="8"
              Margin="0,0,0,16">

            <Button
                Grid.Column="0"
                x:Name="SaveButton"
                Text="Save"
                BackgroundColor="#4F6EF7"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="40"
                Clicked="OnSaveClicked"/>

            <Button
                Grid.Column="1"
                x:Name="UndoButton"
                Text="Undo"
                BackgroundColor="#252836"
                TextColor="#E8E8F0"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="40"
                Clicked="OnUndoClicked"/>

            <Button
                Grid.Column="2"
                x:Name="RedoButton"
                Text="Redo"
                BackgroundColor="#252836"
                TextColor="#E8E8F0"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="40"
                Clicked="OnRedoClicked"/>

            <Button
                Grid.Column="3"
                Text="Close"
                BackgroundColor="#2A1A1A"
                TextColor="#FF6B6B"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="40"
                Clicked="OnCloseClicked"/>

        </Grid>

        <!-- Zona de text - File Contents -->
        <Border
            Grid.Row="2"
            BackgroundColor="#1A1D27"
            StrokeShape="RoundRectangle 12"
            Stroke="#2A2D3E"
            StrokeThickness="1">
            <Editor
                x:Name="ContentEditor"
                Placeholder="Start typing..."
                PlaceholderColor="#4A4A60"
                TextColor="#E8E8F0"
                BackgroundColor="Transparent"
                FontSize="15"
                Margin="12"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                AutoSize="Disabled"/>
        </Border>

        <!-- Mesaj status (salvat, eroare etc) -->
        <Label
            Grid.Row="3"
            x:Name="StatusLabel"
            Text=""
            FontSize="13"
            TextColor="#4CAF50"
            IsVisible="False"
            HorizontalOptions="Center"
            Margin="0,12,0,0"/>

    </Grid>

</ContentPage>